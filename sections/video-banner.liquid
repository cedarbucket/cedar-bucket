{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'custom-font.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: 0 !important;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.50 | round: 0 }}px;
    padding-left: 0;
    padding-right: 0;
    margin-top: 0 !important;
    width: 100%;
    position: relative;
    top: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: 0 !important;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: 0;
      padding-right: 0;
    }
  }

  .video-banner__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .video-banner__video iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .video-banner__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
  }

  /* Desktop video - hide on mobile */
  .video-banner__media--desktop {
    display: block;
  }

  /* Mobile video - hide on desktop */
  .video-banner__media--mobile {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .video-banner__media--desktop {
      display: none;
    }
    
    .video-banner__media--mobile {
      display: block;
    }
  }

  .banner__image-block {
    margin: 1rem 0;
    width: 100%;
  }
  
  .banner-block-image {
    height: auto;
    display: inline-block;
  }

  {%- for block in section.blocks -%}
    {% case block.type %}
      {% when 'heading' %}
        #VideoBanner-{{ section.id }} .banner__heading-{{ block.id }} {
          font-size: {{ block.settings.heading_font_size }}px !important;
          color: white !important;
          
          {% if block.settings.custom_font %}
            font-family: '{{ block.settings.custom_font }}' !important;
          {% endif %}
        }
        @media screen and (max-width: 749px) {
          #VideoBanner-{{ section.id }} .banner__heading-{{ block.id }} {
            font-size: {{ block.settings.heading_font_size_mobile }}px !important;
          }
        }
      {% when 'text' %}
        #VideoBanner-{{ section.id }} .banner__text-{{ block.id }},
        #VideoBanner-{{ section.id }} .banner__text-{{ block.id }} p,
        #VideoBanner-{{ section.id }} .banner__text-{{ block.id }} * {
          font-size: {{ block.settings.font_size }}px !important;
          color: white !important;
      
          {% if block.settings.custom_font %}
            font-family: '{{ block.settings.custom_font }}' !important;
          {% endif %}
        }
        @media screen and (max-width: 749px) {
          #VideoBanner-{{ section.id }} .banner__text-{{ block.id }},
          #VideoBanner-{{ section.id }} .banner__text-{{ block.id }} p,
          #VideoBanner-{{ section.id }} .banner__text-{{ block.id }} * {
            font-size: {{ block.settings.font_size_mobile }}px !important;
          }
        }
    {% endcase %}
  {%- endfor -%}
{%- endstyle -%}

{%- style -%}
  #VideoBanner-{{ section.id }} {
    border-radius: {{ section.settings.section_radius | times: 0.75 | round: 0 }}px;
    overflow: hidden;
    {% if section.settings.show_box_shadow %}
      box-shadow: 1px 1px 15px 8px rgba(0,0,0,0.5);
    {% endif %}
    {% if section.settings.show_box_border %}
      border: 1px solid white;
    {% endif %}
    min-height: 100vh;
    min-height: 100svh; /* Small viewport height - includes status bar */
    height: 100vh;
    height: 100svh;
    position: relative;
    width: 100%;
    margin-top: 0 !important;
    top: 0;
  }

  #VideoBanner-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ section.settings.video_overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
    z-index: 2;
  }

  /* Additional overlay for better visibility */
  #VideoBanner-{{ section.id }} .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ section.settings.video_overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
    z-index: 2;
  }

  #VideoBanner-{{ section.id }} .banner__content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    box-sizing: border-box;
  }

  /* Content positioning */
  #VideoBanner-{{ section.id }} .banner__content--top-left {
    align-items: flex-start;
    justify-content: flex-start;
  }
  
  #VideoBanner-{{ section.id }} .banner__content--top-center {
    align-items: flex-start;
    justify-content: center;
  }
  
  #VideoBanner-{{ section.id }} .banner__content--top-right {
    align-items: flex-start;
    justify-content: flex-end;
  }
  
  #VideoBanner-{{ section.id }} .banner__content--middle-left {
    align-items: center;
    justify-content: flex-start;
  }
  
  #VideoBanner-{{ section.id }} .banner__content--middle-center {
    align-items: center;
    justify-content: center;
  }
  
  #VideoBanner-{{ section.id }} .banner__content--middle-right {
    align-items: center;
    justify-content: flex-end;
  }
  
  #VideoBanner-{{ section.id }} .banner__content--bottom-left {
    align-items: flex-end;
    justify-content: flex-start;
  }
  
  #VideoBanner-{{ section.id }} .banner__content--bottom-center {
    align-items: flex-end;
    justify-content: center;
  }
  
  #VideoBanner-{{ section.id }} .banner__content--bottom-right {
    align-items: flex-end;
    justify-content: flex-end;
  }

  /* Transparent background for content box */
  #VideoBanner-{{ section.id }} .banner__box {
    background: transparent !important;
    backdrop-filter: none !important;
  }

  /* Ensure text is visible over video (but allow specific overrides) */
  #VideoBanner-{{ section.id }} .banner__box {
    color: white;
  }

  #VideoBanner-{{ section.id }} .banner__box .btn {
    border-color: white;
  }

  #VideoBanner-{{ section.id }} .banner__box .btn:not(.btn--secondary) {
    background-color: rgba(255, 255, 255, 0.9);
    color: black;
  }

  @media screen and (max-width: 768px) {
    #VideoBanner-{{ section.id }} {
      min-height: 100vh;
      min-height: 100svh;
      height: 100vh;
      height: 100svh;
    }
    
    /* Ensure full coverage on mobile devices */
    #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    
    /* Cover status bar area on iOS */
    @supports (height: 100svh) {
      #VideoBanner-{{ section.id }} {
        height: 100svh;
        min-height: 100svh;
        margin-top: calc(env(safe-area-inset-top) * -1);
        padding-top: env(safe-area-inset-top);
      }
    }
  }
    

  }
{%- endstyle -%}

<div
  id="VideoBanner-{{ section.id }}"
  class="{{ section.settings.desktop_content_alignment | default: 'center' }} banner banner--content-align-{{ section.settings.desktop_content_alignment | default: 'center' }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment | default: 'center' }}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- liquid
    assign desktop_video_url = section.settings.background_video_url
    assign desktop_video_file = section.settings.background_video_file
    assign desktop_fallback_image = section.settings.desktop_fallback_image
    assign mobile_video_url = section.settings.mobile_background_video_url
    assign mobile_video_file = section.settings.mobile_background_video_file
    assign mobile_fallback_image = section.settings.mobile_fallback_image
    
    assign autoplay_val = 0
    assign muted_val = 0
    assign controls_val = 1
    assign loop_val = 0
    
    if section.settings.autoplay
      assign autoplay_val = 1
    endif
    if section.settings.muted
      assign muted_val = 1
    endif
    if section.settings.controls
      assign controls_val = 1
    else
      assign controls_val = 0
    endif
    if section.settings.loop
      assign loop_val = 1
    endif
  -%}

  <!-- Desktop Video -->
  <div class="video-banner__media video-banner__media--desktop media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {%- if desktop_video_url != blank -%}
      {%- liquid
        assign video_url = desktop_video_url
        assign video_id = ''
        assign video_type = ''
        
        if video_url contains 'youtube.com' or video_url contains 'youtu.be'
          assign video_type = 'youtube'
          if video_url contains 'watch?v='
            assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first
          elsif video_url contains 'youtu.be/'
            assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
          endif
        elsif video_url contains 'vimeo.com'
          assign video_type = 'vimeo'
          assign video_id = video_url | split: 'vimeo.com/' | last | split: '?' | first
        endif
      -%}
      
      {%- if video_type == 'youtube' and video_id != blank -%}
        <iframe
          class="video-banner__video"
          src="https://www.youtube.com/embed/{{ video_id }}?autoplay={{ autoplay_val }}&loop={{ loop_val }}&mute={{ muted_val }}&controls={{ controls_val }}&playlist={{ video_id }}&rel=0"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
        <div class="video-overlay"></div>
      {%- elsif video_type == 'vimeo' and video_id != blank -%}
        <iframe
          class="video-banner__video"
          src="https://player.vimeo.com/video/{{ video_id }}?autoplay={{ autoplay_val }}&loop={{ loop_val }}&muted={{ muted_val }}&controls={{ controls_val }}"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
        <div class="video-overlay"></div>
      {%- endif -%}
    {%- elsif desktop_video_file != blank -%}
      <video
        class="video-banner__video"
        {% if section.settings.autoplay %}autoplay{% endif %}
        {% if section.settings.loop %}loop{% endif %}
        {% if section.settings.muted %}muted{% endif %}
        {% if section.settings.controls %}controls{% endif %}
        playsinline
        preload="metadata"
      >
        <source src="{{ desktop_video_file }}" type="video/mp4">
        Your browser does not support the video tag.
      </video>
      <div class="video-overlay"></div>
    {%- elsif desktop_fallback_image != blank -%}
      {{
        desktop_fallback_image
        | image_url: width: 1920
        | image_tag:
          class: 'video-banner__fallback-image',
          loading: 'lazy'
      }}
    {%- endif -%}
  </div>

  <!-- Mobile Video -->
  <div class="video-banner__media video-banner__media--mobile media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {%- if mobile_video_url != blank -%}
      {%- liquid
        assign video_url = mobile_video_url
        assign video_id = ''
        assign video_type = ''
        
        if video_url contains 'youtube.com' or video_url contains 'youtu.be'
          assign video_type = 'youtube'
          if video_url contains 'watch?v='
            assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first
          elsif video_url contains 'youtu.be/'
            assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
          endif
        elsif video_url contains 'vimeo.com'
          assign video_type = 'vimeo'
          assign video_id = video_url | split: 'vimeo.com/' | last | split: '?' | first
        endif
      -%}
      
      {%- if video_type == 'youtube' and video_id != blank -%}
        <iframe
          class="video-banner__video"
          src="https://www.youtube.com/embed/{{ video_id }}?autoplay={{ autoplay_val }}&loop={{ loop_val }}&mute={{ muted_val }}&controls={{ controls_val }}&playlist={{ video_id }}&rel=0"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
        <div class="video-overlay"></div>
      {%- elsif video_type == 'vimeo' and video_id != blank -%}
        <iframe
          class="video-banner__video"
          src="https://player.vimeo.com/video/{{ video_id }}?autoplay={{ autoplay_val }}&loop={{ loop_val }}&muted={{ muted_val }}&controls={{ controls_val }}"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
        <div class="video-overlay"></div>
      {%- endif -%}
    {%- elsif mobile_video_file != blank -%}
      <video
        class="video-banner__video"
        {% if section.settings.autoplay %}autoplay{% endif %}
        {% if section.settings.loop %}loop{% endif %}
        {% if section.settings.muted %}muted{% endif %}
        {% if section.settings.controls %}controls{% endif %}
        playsinline
        preload="metadata"
      >
        <source src="{{ mobile_video_file }}" type="video/mp4">
        Your browser does not support the video tag.
      </video>
      <div class="video-overlay"></div>
    {%- elsif mobile_fallback_image != blank -%}
      {{
        mobile_fallback_image
        | image_url: width: 1920
        | image_tag:
          class: 'video-banner__fallback-image',
          loading: 'lazy'
      }}
    {%- endif -%}
  </div>

  <!-- Fallback when no videos are set -->
  {%- if desktop_video_url == blank and desktop_video_file == blank and desktop_fallback_image == blank and mobile_video_url == blank and mobile_video_file == blank and mobile_fallback_image == blank -%}
    <div class="video-banner__media media placeholder{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="banner__content banner__content--{{ section.settings.desktop_content_position | default: 'middle-center' }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="banner__box content-container content-container--full-width-mobile" style="background: transparent; --color-foreground: white; --color-link: white;">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'image' -%}
            <div class="banner__image-block" 
                 style="text-align: {{ block.settings.alignment }};"
                 {{ block.shopify_attributes }}>
              {%- if block.settings.block_image != blank -%}
                <style>
                  #shopify-section-{{ section.id }} .banner-block-image {
                    width: {{ block.settings.image_width }}px;
                  }
                  @media screen and (max-width: 749px) {
                    #shopify-section-{{ section.id }} .banner-block-image {
                      width: {{ block.settings.image_width_mobile }}px;
                    }
                  }
                </style>
                {{ block.settings.block_image | image_url: width: block.settings.image_width | image_tag:
                  loading: 'lazy',
                  class: 'banner-block-image'
                }}
              {%- endif -%}
            </div>
          {%- when 'heading' -%}
            <h2 
              class="banner__heading inline-richtext banner__heading-{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading }}
            </h2>
          {%- when 'text' -%}
            <div
              class="banner__text rte {{ block.settings.text_style }} banner__text-{{ block.id }}"
              {{ block.shopify_attributes }}              
            >
              {{ block.settings.text }}
            </div>
          {%- when 'buttons' -%}
            <div
              class="banner__buttons{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
                  style="
                    padding-top: {{ block.settings.btn_one_padding_top }}px;
                    padding-bottom: {{ block.settings.btn_one_padding_bottom }}px;
                    padding-left: {{ block.settings.btn_one_padding_left }}px;
                    padding-right: {{ block.settings.btn_one_padding_right }}px;
                  "
                >
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                  style="
                    padding-top: {{ block.settings.btn_two_padding_top }}px;
                    padding-bottom: {{ block.settings.btn_two_padding_bottom }}px;
                    padding-left: {{ block.settings.btn_two_padding_left }}px;
                    padding-right: {{ block.settings.btn_two_padding_right }}px;
                  "
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Basic Settings"
    },
    {
      "type": "header",
      "content": "Desktop Video Settings"
    },
    {
      "type": "url",
      "id": "background_video_url",
      "label": "Desktop YouTube/Vimeo Video URL",
      "info": "Enter a YouTube or Vimeo URL for desktop (e.g., https://www.youtube.com/watch?v=VIDEO_ID)"
    },
    {
      "type": "url",
      "id": "background_video_file",
      "label": "Desktop Direct Video File URL (Optional)",
      "info": "Enter direct URL to MP4 video file for desktop. To upload videos: Go to Settings > Files in admin, upload your MP4, then copy the URL here."
    },
    {
      "type": "image_picker",
      "id": "desktop_fallback_image",
      "label": "Desktop Fallback Image",
      "info": "Image to show on desktop when video is not available or fails to load"
    },
    {
      "type": "header",
      "content": "Mobile Video Settings"
    },
    {
      "type": "url",
      "id": "mobile_background_video_url",
      "label": "Mobile YouTube/Vimeo Video URL",
      "info": "Enter a YouTube or Vimeo URL for mobile (e.g., https://www.youtube.com/watch?v=VIDEO_ID)"
    },
    {
      "type": "url",
      "id": "mobile_background_video_file",
      "label": "Mobile Direct Video File URL (Optional)",
      "info": "Enter direct URL to MP4 video file for mobile. To upload videos: Go to Settings > Files in admin, upload your MP4, then copy the URL here."
    },
    {
      "type": "image_picker",
      "id": "mobile_fallback_image",
      "label": "Mobile Fallback Image",
      "info": "Image to show on mobile when video is not available or fails to load"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "Autoplay Video",
      "info": "Video will autoplay when the page loads"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "default": true,
      "label": "Loop Video",
      "info": "Video will restart when it reaches the end"
    },
    {
      "type": "checkbox",
      "id": "muted",
      "default": true,
      "label": "Mute Video",
      "info": "Video will be muted by default. Required for autoplay on most browsers."
    },
    {
      "type": "checkbox",
      "id": "controls",
      "default": false,
      "label": "Show Video Controls",
      "info": "Display play/pause and volume controls"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "video_height",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Desktop Video Height",
      "default": 600
    },
    {
      "type": "range",
      "id": "video_height_mobile",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Mobile Video Height",
      "default": 400
    },
    {
      "type": "range",
      "id": "video_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Video Overlay Opacity",
      "default": 30
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-center",
          "label": "Top center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "middle-left",
          "label": "Middle left"
        },
        {
          "value": "middle-center",
          "label": "Middle center"
        },
        {
          "value": "middle-right",
          "label": "Middle right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "middle-center",
      "label": "Desktop Content Position"
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "default": true,
      "label": "Show Text Background Box"
    },
    {
      "type": "range",
      "id": "adjust_content_position",
      "label": "Adjust Content Position",
      "min": -50,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_radius",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section Border Radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_box_shadow",
      "default": false,
      "label": "Show Box Shadow"
    },
    {
      "type": "checkbox",
      "id": "show_box_border",
      "default": false,
      "label": "Show Box Border"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Desktop Content Alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
