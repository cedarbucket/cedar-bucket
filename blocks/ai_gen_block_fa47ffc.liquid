</moving-price-calculator-{{ ai_gen_id }}><script>
(function() {
  class MovingPriceCalculator{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.storageOptions = [
        { value: parseFloat('{{ block.settings.storage_5x5_price }}') || 143, label: '{{ block.settings.storage_5x5_label }}' },
        { value: parseFloat('{{ block.settings.storage_5x10_price }}') || 240, label: '{{ block.settings.storage_5x10_label }}' },
        { value: parseFloat('{{ block.settings.storage_10x10_price }}') || 425, label: '{{ block.settings.storage_10x10_label }}' },
        { value: parseFloat('{{ block.settings.storage_10x15_price }}') || 600, label: '{{ block.settings.storage_10x15_label }}' },
        { value: parseFloat('{{ block.settings.storage_10x20_price }}') || 750, label: '{{ block.settings.storage_10x20_label }}' },
        { value: parseFloat('{{ block.settings.storage_10x30_price }}') || 1050, label: '{{ block.settings.storage_10x30_label }}' }
      ];
    }

    connectedCallback() {
      this.setupEventListeners();
      this.calculateTotal();
    }

    getRates() {
      return {
        moving: parseFloat('{{ block.settings.moving_hourly_rate }}') || 175,
        additionalLocation: parseFloat('{{ block.settings.additional_location_rate }}') || 175,
        packingHandyman: parseFloat('{{ block.settings.packing_handyman_rate }}') || 80,
        assembly: parseFloat('{{ block.settings.assembly_rate }}') || 150,
        shipStorageBase: parseFloat('{{ block.settings.ship_storage_base_rate }}') || 200,
        shipStorageAdditional: parseFloat('{{ block.settings.ship_storage_additional_rate }}') || 10
      };
    }

    setupEventListeners() {
      const inputs = this.querySelectorAll('input, select');
      inputs.forEach(input => {
        input.addEventListener('input', () => this.calculateTotal());
        input.addEventListener('change', () => this.calculateTotal());
      });

      const checkboxes = this.querySelectorAll('input[type="checkbox"]');
      checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', (e) => {
          this.toggleServiceInputs(e.target);
          this.calculateTotal();
        });
      });
    }

    toggleServiceInputs(checkbox) {
      const service = checkbox.dataset.service;
      const relatedInputs = this.querySelectorAll(`[data-service="${service}"]:not([type="checkbox"])`);
      
      relatedInputs.forEach(input => {
        input.disabled = !checkbox.checked;
        if (!checkbox.checked) {
          if (input.type === 'number') {
            input.value = input.min || 0;
          }
        }
      });
    }

    calculateTotal() {
      const rates = this.getRates();
      let total = 0;
      const breakdown = [];

      const movingMinHours = parseFloat('{{ block.settings.moving_minimum_hours }}') || 1.5;
      const movingHours = Math.max(movingMinHours, parseFloat(this.querySelector('#moving-hours-{{ ai_gen_id }}').value) || movingMinHours);
      const additionalLocations = parseInt(this.querySelector('#additional-locations-{{ ai_gen_id }}').value) || 0;
      const movingCost = movingHours * rates.moving;
      const locationCost = additionalLocations * rates.additionalLocation;
      const totalMovingCost = movingCost + locationCost;
      total += totalMovingCost;
      breakdown.push({
        label: `{{ block.settings.moving_section_title }} (${movingHours} hours${additionalLocations > 0 ? `, ${additionalLocations} additional locations` : ''})`,
        amount: totalMovingCost
      });

      const packingHandymanEnabled = this.querySelector('#packing-handyman-service-{{ ai_gen_id }}').checked;
      if (packingHandymanEnabled) {
        const packingHandymanMinHours = parseFloat('{{ block.settings.packing_handyman_minimum_hours }}') || 1;
        const packingHandymanHours = Math.max(packingHandymanMinHours, parseFloat(this.querySelector('#packing-handyman-hours-{{ ai_gen_id }}').value) || packingHandymanMinHours);
        const workersCount = parseInt(this.querySelector('#workers-count-{{ ai_gen_id }}').value) || 1;
        const packingHandymanCost = packingHandymanHours * workersCount * rates.packingHandyman;
        total += packingHandymanCost;
        breakdown.push({
          label: `{{ block.settings.packing_handyman_section_title }} (${packingHandymanHours} hours, ${workersCount} workers)`,
          amount: packingHandymanCost
        });
      }

      const assemblyEnabled = this.querySelector('#assembly-service-{{ ai_gen_id }}').checked;
      if (assemblyEnabled) {
        const assemblyMinHours = parseFloat('{{ block.settings.assembly_minimum_hours }}') || 1;
        const assemblyHours = Math.max(assemblyMinHours, parseFloat(this.querySelector('#assembly-hours-{{ ai_gen_id }}').value) || assemblyMinHours);
        const assemblyCost = assemblyHours * rates.assembly;
        total += assemblyCost;
        breakdown.push({
          label: `{{ block.settings.assembly_section_title }} (${assemblyHours} hours)`,
          amount: assemblyCost
        });
      }

      const storageSelect = this.querySelector('#storage-unit-{{ ai_gen_id }}');
      const selectedIndex = storageSelect.selectedIndex;
      const storageRate = this.storageOptions[selectedIndex].value;
      const storageLabel = this.storageOptions[selectedIndex].label;
      const storageMonths = parseInt(this.querySelector('#storage-months-{{ ai_gen_id }}').value) || 1;
      const storageCost = storageRate * storageMonths;
      total += storageCost;
      breakdown.push({
        label: `${storageLabel} (${storageMonths} months)`,
        amount: storageCost
      });

      const shipStorageEnabled = this.querySelector('#ship-storage-service-{{ ai_gen_id }}').checked;
      if (shipStorageEnabled) {
        const packagesCount = parseInt(this.querySelector('#packages-count-{{ ai_gen_id }}').value) || 1;
        let shipStorageCost = rates.shipStorageBase;
        if (packagesCount > 5) {
          shipStorageCost += (packagesCount - 5) * rates.shipStorageAdditional;
        }
        total += shipStorageCost;
        breakdown.push({
          label: `{{ block.settings.ship_storage_section_title }} (${packagesCount} packages)`,
          amount: shipStorageCost
        });
      }

      this.updateDisplay(total, breakdown);
    }

    updateDisplay(total, breakdown) {
      const totalElement = this.querySelector('#total-amount-{{ ai_gen_id }}');
      const breakdownContainer = this.querySelector('#breakdown-items-{{ ai_gen_id }}');

      totalElement.textContent = `$${total.toFixed(2)}`;

      breakdownContainer.innerHTML = '';
      breakdown.forEach(item => {
        const div = document.createElement('div');
        div.className = 'ai-price-calculator-breakdown-item-{{ ai_gen_id }}';
        div.innerHTML = `
          <span>${item.label}</span>
          <span>$${item.amount.toFixed(2)}</span>
        `;
        breakdownContainer.appendChild(div);
      });
    }
  }

  customElements.define('moving-price-calculator-{{ ai_gen_id }}', MovingPriceCalculator{{ ai_gen_id }});
})();
</script>

