{% doc %}
  @prompt
    I need an title and body text section with a square image above it. 
    
    TITLE Cedar Bucket 2026 Pre-Sales – Reserve Your Spot Now
    
    BODY Cedar Bucket has been Oxford’s #1 choice for Ole Miss student moving and storage, voted Best Moving Company and Best Storage Company in Oxford for 2025. We’re opening limited pre-sales for Summer 2026, and space will go fast.
    
    
    i'll select the image on top.
    
    Allow me to select image and change font

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-title-body-image-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-title-body-image__image-container-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    margin-bottom: {{ block.settings.spacing }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-title-body-image__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-title-body-image__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-title-body-image__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-title-body-image__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-title-body-image__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.spacing }}px 0;
    line-height: 1.2;
  }

  .ai-title-body-image__body-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-style: {{ block.settings.body_font.style }};
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    line-height: 1.5;
    max-width: {{ block.settings.content_width }}px;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-title-body-image__image-container-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;
      height: {{ block.settings.image_size | times: 0.8 }}px;
    }

    .ai-title-body-image__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-title-body-image__body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-title-body-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-title-body-image__image-container-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 800 }}"
        alt="{{ block.settings.image.alt | escape }}"
        class="ai-title-body-image__image-{{ ai_gen_id }}"loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
      >
    {% else %}
      <div class="ai-title-body-image__placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-title-body-image__empty-state-{{ ai_gen_id }}">
          Select an image
        </div>
      </div>
    {% endif %}
  </div>

  {% if block.settings.title != blank %}
    <h2 class="ai-title-body-image__title-{{ ai_gen_id }}">
      {{ block.settings.title }}
    </h2>
  {% endif %}

  {% if block.settings.body != blank %}
    <div class="ai-title-body-image__body-{{ ai_gen_id }}">
      {{ block.settings.body }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Title and body with image",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 100,
      "max": 400,
      "step": 20,
      "unit": "px",
      "label": "Image size",
      "default": 200
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Cedar Bucket 2026 Pre-Sales – Reserve Your Spot Now"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Cedar Bucket has been Oxford's #1 choice for Ole Miss student moving and storage, voted Best Moving Company and Best Storage Company in Oxford for 2025. We're opening limited pre-sales for Summer 2026, and space will go fast."
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 600
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Title font",
      "default": "helvetica_n7"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "helvetica_n4"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body size",
      "default": 16
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Spacing between elements",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Title and body with image"
    }
  ]
}
{% endschema %}