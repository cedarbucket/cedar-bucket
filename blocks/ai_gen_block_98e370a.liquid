        <h3 class="ai-luxury-presale__premium-title-{{ ai_gen_id }}">{{ block.settings.feature_2_title }}</h3>
        <p class="ai-luxury-presale__premium-description-{{ ai_gen_id }}">{{ block.settings.feature_2_description }}</p>
      </div>
      <div class="ai-luxury-presale__premium-item-{{ ai_gen_id }}">
        <svg class="ai-luxury-presale__premium-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M16 3h5v5"/>
          <path d="M8 3H3v5"/>
          <path d="M12 22V8"/>
          <path d="M16 8l-4-5-4 5"/>
          <path d="M21 8l-5 5"/>
          <path d="M3 8l5 5"/>
        </svg>
        <h3 class="ai-luxury-presale__premium-title-{{ ai_gen_id }}">{{ block.settings.feature_3_title }}</h3>
        <p class="ai-luxury-presale__premium-description-{{ ai_gen_id }}">{{ block.settings.feature_3_description }}</p>
      </div>
    </div>
  </div>

  <div class="ai-luxury-presale__section-{{ ai_gen_id }}">
    <h2 class="ai-luxury-presale__section-title-{{ ai_gen_id }}">{{ block.settings.additional_services_title }}</h2>
    <p class="ai-luxury-presale__item-description-{{ ai_gen_id }}" style="margin-bottom: 20px;">{{ block.settings.additional_services_description }}</p>
    <div class="ai-luxury-presale__additional-grid-{{ ai_gen_id }}"><div class="ai-luxury-presale__additional-item-{{ ai_gen_id }}">
        <svg class="ai-luxury-presale__additional-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
        <h3 class="ai-luxury-presale__additional-title-{{ ai_gen_id }}">{{ block.settings.additional_service_1 }}</h3>
        <p class="ai-luxury-presale__additional-description-{{ ai_gen_id }}">{{ block.settings.additional_service_1_description }}</p>
      </div>
      <div class="ai-luxury-presale__additional-item-{{ ai_gen_id }}">
        <svg class="ai-luxury-presale__additional-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5"/>
          <path d="M2 12l10 5 10-5"/>
          <circle cx="12" cy="12" r="2"/>
          <path d="M9 9l6 6"/>
          <path d="M15 9l-6 6"/>
        </svg>
        <h3 class="ai-luxury-presale__additional-title-{{ ai_gen_id }}">{{ block.settings.additional_service_2 }}</h3>
        <p class="ai-luxury-presale__additional-description-{{ ai_gen_id }}">{{ block.settings.additional_service_2_description }}</p>
      </div>
      <div class="ai-luxury-presale__additional-item-{{ ai_gen_id }}">
        <svg class="ai-luxury-presale__additional-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
          <polyline points="3.27,6.96 12,12.01 20.73,6.96"/>
          <line x1="12" y1="22.08" x2="12" y2="12"/>
        </svg>
        <h3 class="ai-luxury-presale__additional-title-{{ ai_gen_id }}">{{ block.settings.additional_service_3 }}</h3>
        <p class="ai-luxury-presale__additional-description-{{ ai_gen_id }}">{{ block.settings.additional_service_3_description }}</p>
      </div>
    </div>
    <p class="ai-luxury-presale__additional-note-{{ ai_gen_id }}">{{ block.settings.additional_services_note }}</p>
  </div>

  <div class="ai-luxury-presale__section-{{ ai_gen_id }} ai-luxury-presale__section--cta-{{ ai_gen_id }}">
    <h2 class="ai-luxury-presale__cta-title-{{ ai_gen_id }}">{{ block.settings.cta_title }}</h2>
    <p class="ai-luxury-presale__cta-text-{{ ai_gen_id }}">{{ block.settings.cta_description }}</p>
    
    <div class="ai-luxury-presale__buttons-{{ ai_gen_id }}">
      {% if block.settings.cta_product %}
        <a href="{{ block.settings.cta_product.url }}" class="ai-luxury-presale__button-{{ ai_gen_id }} ai-luxury-presale__button--primary-{{ ai_gen_id }}">
          {{ block.settings.primary_btn_text }}
        </a>
      {% endif %}
      {% if block.settings.secondary_button_link %}
        <a href="{{ block.settings.secondary_button_link }}" class="ai-luxury-presale__button-{{ ai_gen_id }} ai-luxury-presale__button--secondary-{{ ai_gen_id }}">
          {{ block.settings.secondary_btn_text }}
        </a>
