{% doc %}
  @prompt
    display this in a luxury way - i need to be able to edit all fonts. I only need icons for the premium package.
    
    Make it very clear what we offer utilizing mutli column set up for whats included and display it diffferently for the add on services.
    
    What's Included in the Premium Package
    What's Included in the Premium Package
    White-glove moving service
    Our student movers come pick up your belongings directly from your dorm, apartment, or house. We carefully load your items onto our moving trucks and take them back to our facility to store.
    
    Climate-controlled storage
    Your items are stored in our secure, professionally managed facility designed to protect against humidity, heat, and damage.
    
    Delivery back to your new space
    When the fall semester begins, we return and set up your belongings where you need them.
    
    Additional Services Available for Add-On
    Ship-to-Storage service
    Can't bring everything with you? Need to purchase items online? Opt into our ship to service. Simply ship items to the Cedar Bucket, and we'll place them in your reserved unit on your behalf.
    
    Handyman services
    Our student movers will handle the assembly and/or disassembly of any items you need during your move.
    
    Packing Supply Delivery
    We can provide you with all the boxes and moving supplies needed in advance., do not bold the main title, make the icon of move out serive to an arrow pointed right and the icon of the move in serivce to an arrow pointed left, remove main title and main subtitle, add a right arrow as the icon of white glove moving service

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-pricing-{{ ai_gen_id }} {
    padding: 60px 40px;
    background: {{ block.settings.background_color }};
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-luxury-pricing__premium-section-{{ ai_gen_id }} {
    background: {{ block.settings.premium_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 50px;
    margin-bottom: 50px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    border: 2px solid {{ block.settings.premium_border_color }};
  }

  .ai-luxury-pricing__premium-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-luxury-pricing__premium-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.section_title_font.family }}, {{ block.settings.section_title_font.fallback_families }};
    font-weight: {{ block.settings.section_title_font.weight }};
    font-size: {{ block.settings.section_title_size }}px;
    color: {{ block.settings.premium_title_color }};
    margin: 0;position: relative;
    display: inline-block;
  }

  .ai-luxury-pricing__premium-title-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: {{ block.settings.accent_color }};
  }

  .ai-luxury-pricing__premium-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    margin-top: 40px;
  }

  .ai-luxury-pricing__premium-item-{{ ai_gen_id }} {
    text-align: center;
    padding: 30px 20px;
    background: {{ block.settings.item_bg_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border: 1px solid {{ block.settings.item_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-luxury-pricing__premium-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
  }

  .ai-luxury-pricing__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto 20px;
    background: {{ block.settings.icon_bg_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-luxury-pricing__icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size | times: 0.6 }}px;
    height: {{ block.settings.icon_size | times: 0.6 }}px;
  }

  .ai-luxury-pricing__item-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.item_title_font.family }}, {{ block.settings.item_title_font.fallback_families }};
    font-weight: {{ block.settings.item_title_font.weight }};
    font-size: {{ block.settings.item_title_size }}px;
    color: {{ block.settings.item_title_color }};
    margin: 0 0 15px;}

  .ai-luxury-pricing__item-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.item_description_font.family }}, {{ block.settings.item_description_font.fallback_families }};
    font-weight: {{ block.settings.item_description_font.weight }};
    font-size: {{ block.settings.item_description_size }}px;
    color: {{ block.settings.item_description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-luxury-pricing__addon-section-{{ ai_gen_id }} {
    background: {{ block.settings.addon_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 40px;
    border: 1px solid {{ block.settings.addon_border_color }};
  }

  .ai-luxury-pricing__addon-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
  }

  .ai-luxury-pricing__addon-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.section_title_font.family }}, {{ block.settings.section_title_font.fallback_families }};
    font-weight: {{ block.settings.section_title_font.weight }};
    font-size: {{ block.settings.section_title_size }}px;
    color: {{ block.settings.addon_title_color }};
    margin: 0;
  }

  .ai-luxury-pricing__addon-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .ai-luxury-pricing__addon-item-{{ ai_gen_id }} {
    padding: 25px;
    background: {{ block.settings.addon_item_bg_color }};
    border-radius: {{ block.settings.addon_item_border_radius }}px;
    border-left: 4px solid {{ block.settings.accent_color }};
    transition: background-color 0.3s ease;
  }

  .ai-luxury-pricing__addon-item-{{ ai_gen_id }}:hover {
    background: {{ block.settings.addon_item_hover_bg_color }};
  }

  .ai-luxury-pricing__addon-item-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.addon_item_title_font.family }}, {{ block.settings.addon_item_title_font.fallback_families }};
    font-weight: {{ block.settings.addon_item_title_font.weight }};
    font-size: {{ block.settings.addon_item_title_size }}px;
    color: {{ block.settings.addon_item_title_color }};
    margin: 0 0 10px;
  }

  .ai-luxury-pricing__addon-item-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.addon_item_description_font.family }}, {{ block.settings.addon_item_description_font.fallback_families }};
    font-weight: {{ block.settings.addon_item_description_font.weight }};
    font-size: {{ block.settings.addon_item_description_size }}px;
    color: {{ block.settings.addon_item_description_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-luxury-pricing-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-luxury-pricing__premium-section-{{ ai_gen_id }},
    .ai-luxury-pricing__addon-section-{{ ai_gen_id }} {
      padding: 30px20px;
    }

    .ai-luxury-pricing__premium-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .ai-luxury-pricing__premium-title-{{ ai_gen_id }},
    .ai-luxury-pricing__addon-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}<div class="ai-luxury-pricing-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
