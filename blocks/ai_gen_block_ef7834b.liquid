{% doc %}
  @prompt
    need a high quality way to display this.
    
    Additional Services
    Subject to availability of staff and early scheduling, Cedar Bucket also offers:
    • Handyman services
    • Assembly and disassembly services 
    • Packing services
    Further details can be provided post reservation., change the color from green to black for the icons

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-services-display-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    max-width: 100%;
  }

  .ai-services-display__header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-services-display__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    margin: 0 0 {{ block.settings.title_margin }}px 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-services-display__subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    text-align: {{ block.settings.text_alignment }};
    font-style: {{ block.settings.subtitle_style }};
  }

  .ai-services-display__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: {{ block.settings.list_spacing }}px 0 0 0;
  }

  .ai-services-display__item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    margin-bottom: {{ block.settings.item_spacing }}px;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border-left: {{ block.settings.accent_width }}px solid {{ block.settings.accent_color }};
  }

  .ai-services-display__item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-services-display__icon-{{ ai_gen_id }} {
    color: {{ block.settings.icon_color }};
    margin-right: {{ block.settings.icon_spacing }}px;
    margin-top: 2px;
    flex-shrink: 0;
  }

  .ai-services-display__icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .ai-services-display__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0;}

  .ai-services-display__footer-{{ ai_gen_id }} {
    margin-top: {{ block.settings.footer_spacing }}px;
    padding-top: {{ block.settings.footer_spacing }}px;
    border-top: 1px solid {{ block.settings.border_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-services-display__note-{{ ai_gen_id }} {
    color: {{ block.settings.note_color }};
    font-size: {{ block.settings.note_size }}px;
    font-style: {{ block.settings.note_style }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-services-display-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.8 }}px;
    }

    .ai-services-display__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-services-display__item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}<div class="ai-services-display-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-services-display__header-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-services-display__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}
    
    {% if block.settings.subtitle != blank %}
      <p class="ai-services-display__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {% endif %}
  </div>

  <ul class="ai-services-display__list-{{ ai_gen_id }}">
    {% if block.settings.service_1 != blank %}
      <li class="ai-services-display__item-{{ ai_gen_id }}">
        <div class="ai-services-display__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
          </svg>
        </div>
        <p class="ai-services-display__text-{{ ai_gen_id }}">{{ block.settings.service_1 }}</p>
      </li>
    {% endif %}

    {% if block.settings.service_2 != blank %}
      <li class="ai-services-display__item-{{ ai_gen_id }}">
        <div class="ai-services-display__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
          </svg>
        </div>
        <p class="ai-services-display__text-{{ ai_gen_id }}">{{ block.settings.service_2 }}</p>
      </li>
    {% endif %}

    {% if block.settings.service_3 != blank %}
      <li class="ai-services-display__item-{{ ai_gen_id }}">
        <div class="ai-services-display__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
          </svg>
        </div>
        <p class="ai-services-display__text-{{ ai_gen_id }}">{{ block.settings.service_3 }}</p>
      </li>
    {% endif %}
  </ul>

  {% if block.settings.footer_note != blank %}
    <div class="ai-services-display__footer-{{ ai_gen_id }}">
      <p class="ai-services-display__note-{{ ai_gen_id }}">{{ block.settings.footer_note }}</p>
    </div>
  {% endif %}
</div>

