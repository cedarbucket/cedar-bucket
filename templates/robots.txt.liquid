{% for group in robots.default_groups %}
  {{ group.user_agent }}

      {% for rule in group.rules %}
      {%- assign rule_str = rule | strip | downcase -%}
      {%- if rule_str contains 'blogs' -%}
        # SKIPPED: {{ rule }}
      {%- else -%}
        {{- rule -}}
      {%- endif -%}
    {% endfor %}

  {% if group.sitemap != blank %}
    {{ group.sitemap }}
  {% endif %}
{% endfor %}