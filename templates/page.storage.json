      "type": "_blocks",
      "blocks": {
        "ai_gen_block_8825c76_yxe3xR": {
          "type": "ai_gen_block_8825c76",
          "settings": {
            "title": "Reserve Your Spot Today",
            "accent_word": "Today",
            "body_text": "<p>Reserve your spot with a $500 deposit today and gain access to a 1:1 consultation with a Cedar Bucket team member. During this meeting, we’ll create a custom service package and review all details and pricing with you.</p>",
            "button_text": "Reserve Now",
            "button_product": "",
            "button_url": "",
            "footer_text": "<p>Further details about pricing will be covered in your one-on-one consultation that can be scheduled post checkout.</p>",
            "padding_top": 20,
            "padding_bottom": 20,
            "title_font": "serif",
            "title_size": 34,
            "body_font": "serif",
            "body_size": 18,
