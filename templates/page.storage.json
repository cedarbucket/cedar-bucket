      "blocks": {
        "collapsible_row_NG6bxw": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What storage size do I need?",
            "icon": "none",
            "row_content": "<p>5x10 should cover one full bedroom. If you have other large items like a couch, entertainment center, barstools, etc., you will need to upgrade.</p>",
            "page": ""
          }
        },
        "collapsible_row_FVxgR6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I add more items throughout the summer?",
            "icon": "none",
            "row_content": "<p>Yes! If you have space available you can add to it through our pick up or ship ahead options. </p>",
            "page": ""
          }
        },
        "collapsible_row_fCinT4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I schedule pick up / delivery?",
            "icon": "none",
            "row_content": "<p>Call us anytime from 9-5 M-F or email us at info@cedarbucket.com to schedule your pick-up or delivery. </p>",
            "page": ""
          }
        },
        "collapsible_row_RUA9py": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How does ship ahead services work?",
            "icon": "none",
            "row_content": "<p>Email your ship ahead request at info@cedarbucket.com with a tracking number and a brief description. Our team will handle the rest!</p>",
            "page": ""
          }
        },
        "collapsible_row_Kjp8MQ": {
          "type": "collapsible_row",
