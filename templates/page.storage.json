    "rich_text_tazjYL": {
      "type": "rich-text",
      "blocks": {
        "heading_Ujhaa3": {
          "type": "heading",
          "settings": {
            "heading": "What is the full pricing?",
            "sb_custom_font": "Neutra Text Book",
            "heading_size": "h1"
          }
        },
        "text_GV8Gyd": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Moving Services</strong><br/><br/>• $175 per hour for two movers and a truck<br/></p><p>• 1.5-hour minimum per location<br/></p><p>Services are billed after completion<br/><br/><strong>Storage Rates</strong><br/><br/>•    5x5 Unit – $143/month <br/>    •    5x10 Unit – $240/month<br/>    •    10x10 Unit – $375/month<br/>    •    10x15 Unit – $600/month<br/>    •    10x20 Unit – $750/month<br/>    •    10x30 Unit – $1,050/month<br/><strong><br/>Ship-to-Storage Program</strong><br/><br/>• $200 flat fee for up to 5 packages of any size<br/><br/>• $10 per package for each additional item</p>",
            "sb_custom_font": "Neutra Text Book",
            "sb_font_size": 24,
            "sb_font_weight": 400
          }
        }
      },
      "block_order": [
        "heading_Ujhaa3",
        "text_GV8Gyd"
      ],
      "disabled": true,
      "name": "t:sections.rich-text.presets.name",
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "",
        "full_width": true,
        "border_style": false,
        "padding_top": 40,
        "padding_left": 0,
        "padding_right": 0,
        "padding_bottom": 52
      }
    },
    "rich_text_Yi3zFJ": {
      "type": "rich-text",
      "blocks": {
        "heading_AKGq9r": {
          "type": "heading",
          "settings": {
            "heading": "What are your Packing Requirements?",
            "sb_custom_font": "Neutra Text Book",
            "heading_size": "h1"
          }
        },
        "text_8PiX8e": {
          "type": "text",
          "settings": {
            "text": "<p>To ensure belongings are returned in the same condition, we require the following. If you cannot source packing materials, Cedar Bucket can provide them at an additional charge.<br/><br/>• Fabric items must be protected and wrapped before the move. Stretch wrap is available upon request for the cost of materials.<br/><br/>• TVs must be packed in sturdy, durable TV boxes. TV Boxes is available upon request for the cost of the material.<br/><br/>• Glass, mirrors, and other fragile items must be wrapped in bubble wrap. Bubble wrap is provided upon request at cost of the material. <br/><br/>• Bed frames, TV mounts, and other items with loose parts must be secured and labeled separately.<br/><br/>• Customized labels with your information will be delivered prior to your move.<br/><br/>• Customers are required to label belongings clearly using these labels to ensure proper tracking.</p>",
            "sb_custom_font": "Neutra Text Book",
            "sb_font_size": 24,
            "sb_font_weight": 400
          }
        }
      },
      "block_order": [
        "heading_AKGq9r",
        "text_8PiX8e"
      ],
