    "image_with_text_BdAn7d": {
      "type": "image-with-text",
      "blocks": {
        "heading_pyxfmG": {
          "type": "heading",
          "settings": {
            "heading": "History",
            "heading_size": "h0",
            "sb_custom_font": "Neutra Text Bold"
