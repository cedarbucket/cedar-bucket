    "parallax_gallery_with_text_CMFqHt": {
      "type": "parallax-gallery-with-text",
      "blocks": {
        "heading_aDUxfL": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Mission:</strong>",
            "sb_custom_font": "Neutra Text Bold",
            "heading_size": "h0"
          }
        },
        "text_MAb6Eg": {
          "type": "text",
          "settings": {
            "text": "<p>Cedar Bucket is a local, family-run business founded by Ole Miss alumni who saw a real need in our community—and made it happen. With high demand for affordable furniture and better storage solutions, we created an all-in-one platform to buy, sell, store, and move home furnishings hassle-free. </p><p></p><p>More than just a business, we have fully renovated and  revived the well known Cedar Bucket property in Oxford, preserving its legacy while bringing a much-needed service to town. Whether you’re shopping, storing, or moving, we’re here to make it easy.</p>",
            "sb_custom_font": "Neutra Text Book",
            "sb_font_size": 22,
            "sb_font_weight": 400
          }
        },
